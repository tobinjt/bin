#!/bin/bash

set -e -f -u -o pipefail

# Note on launchctl error handling:
# `launchctl bootout` and `launchctl kill` use `|| true` (and stderr suppression)
# because they can return non-zero exit codes in benign situations:
# 1. Race conditions: If a process terminates after SIGTERM during sleep intervals,
#    launchd may have already torn down the service before `bootout` executes,
#    returning exit code 3 ("No such process").
# 2. Idempotency: `bootout` is used to ensure a service is unloaded prior to
#    bootstrapping or cleaning up leftovers. If the service is already gone,
#    `set -e` should not abort execution.
# 3. Idle services: `launchctl kill` returns an error if the service is registered
#    with launchd but has no actively running process instance at that moment.

output_plist() {
  local app="$1" label="$2" timeout="$3"
  # Set up launchd to automatically restart the app when it exits.
  # https://developer.apple.com/library/content/documentation/MacOSX/Conceptual/BPSystemStartup/Chapters/CreatingLaunchdJobs.html
  # man launchd.plist
  # Cookbook section in https://www.launchd.info/
  cat <<END_OF_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>${label}</string>
	<key>ProgramArguments</key>
	<array>
		<string>${HOME}/src/bin/restart-app-automatically-wrapper</string>
		<string>${timeout}</string>
		<string>${app}</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
END_OF_PLIST
}

usage() {
    cat >&2 <<USAGE
Usage: $0 DEST_FILE APP_PATH SERVICE_LABEL TIMEOUT ACTION
E.g. $0 pauses.restart.plist /Applications/Pauses.app Pauses.restart start
- ACTION must be one of: bootout bootstrap list load print remove restart start stop unload
- DEST_FILE will be written in ${HOME}/Library/LaunchAgents
- APP_PATH should be the path to the application base directory, e.g.
  /Applications/foo.app
USAGE
    return 1
}

maybe_reload() {
  local DEST="$1" APP="$2" LABEL="$3" TIMEOUT="$4"
  local DOMAIN="gui/${UID}"
  local SERVICE_TARGET="${DOMAIN}/${LABEL}"
  if ! grep -q "restart-app-automatically-wrapper" "${DEST}"; then
    return
  fi
  if ! diff -u "${DEST}" <(output_plist "${APP}" "${LABEL}" "${TIMEOUT}"); then
    if launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
      # This will kill the app, which is really annoying, but there doesn't seem
      # to be any other way to get launchd to reread the config :(
      launchctl kill SIGTERM "${SERVICE_TARGET}" 2>/dev/null || true
      # Give the app some time to exit.
      printf "Sleeping to give launchd time to kill the app.\\n"
      sleep 3
      launchctl bootout "${SERVICE_TARGET}" 2>/dev/null || true
      # We do not load the config again; any action that needs the config to be
      # loaded ensures that it's loaded, which also handles the situation where
      # the user manually unloaded the config.
    fi
    printf "Updating %s\\n" "${DEST}"
    output_plist "${APP}" "${LABEL}" "${TIMEOUT}" > "${DEST}"
    plutil -lint "${DEST}"
  fi
}

main() {
  if [[ "$#" -ne 5 ]]; then
    usage
    return 1
  fi

  local DEST="$1"
  if [[ "${DEST:0:1}" != "/" ]]; then
    DEST="${HOME}/Library/LaunchAgents/${DEST}"
  fi
  local APP="$2" LABEL="$3" TIMEOUT="$4" ACTION="$5"
  local DOMAIN="gui/${UID}"
  local SERVICE_TARGET="${DOMAIN}/${LABEL}"

  if [[ ! -f "${DEST}" ]]; then
    printf "Creating %s\\n" "${DEST}"
    output_plist "${APP}" "${LABEL}" "${TIMEOUT}" > "${DEST}"
  fi

  case "${ACTION}" in
    list|print)
      if ! launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
        printf "%s aka %s is not loaded\\n" "${DEST}" "${LABEL}" >&2
        return 1
      else
        launchctl print "${SERVICE_TARGET}"
      fi
      ;;
    bootstrap|load)
      maybe_reload "${DEST}" "${APP}" "${LABEL}" "${TIMEOUT}"
      if launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
        launchctl bootout "${SERVICE_TARGET}" 2>/dev/null || true
        sleep 1
      fi
      launchctl bootstrap "${DOMAIN}" "${DEST}"
      ;;
    remove)
      if launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
        launchctl bootout "${SERVICE_TARGET}" 2>/dev/null || true
      fi
      restart-app-automatically-wrapper --kill "${APP}"
      ;;
    restart)
      if launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
        launchctl kill SIGTERM "${SERVICE_TARGET}" 2>/dev/null || true
        sleep 3
        launchctl bootout "${SERVICE_TARGET}" 2>/dev/null || true
      fi
      sleep 1
      launchctl bootstrap "${DOMAIN}" "${DEST}"
      sleep 1
      launchctl kickstart "${SERVICE_TARGET}"
      ;;
    start)
      maybe_reload "${DEST}" "${APP}" "${LABEL}" "${TIMEOUT}"
      if ! launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
        launchctl bootstrap "${DOMAIN}" "${DEST}"
        sleep 1
      fi
      launchctl kickstart "${SERVICE_TARGET}"
      ;;
    stop)
      printf "WARNING: stop is unreliable, consider using bootout instead\\n" >&2
      if launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
        launchctl kill SIGTERM "${SERVICE_TARGET}" 2>/dev/null || true
      fi
      restart-app-automatically-wrapper --kill "${APP}"
      ;;
    bootout|unload)
      if launchctl print "${SERVICE_TARGET}" >/dev/null 2>&1; then
        launchctl kill SIGTERM "${SERVICE_TARGET}" 2>/dev/null || true
        sleep 3
        launchctl bootout "${SERVICE_TARGET}" 2>/dev/null || true
      fi
      restart-app-automatically-wrapper --kill "${APP}"
      ;;
    *)
      printf "Unknown action: %s\\n" "${ACTION}" >&2
      usage
      ;;
  esac
}

main "$@"
