#!/bin/bash

set -e -f -u -o pipefail

update_pre-commit_and_github_workflows() {
  if [[ -x ".github/dependabot.yml" ]]; then
    retry ./.github/dependabot.yml
    git add --all .github
  fi
  if [[ -x ".pre-commit-config.yaml" ]]; then
    retry ./.pre-commit-config.yaml
    git add --all ./.pre-commit-config.yaml
    prek run --all-files
    install-pre-commit-hooks
  fi
  if ! git check-local-copy-is-clean --ignore-unpushed-commits; then
    git commit --quiet --message \
      "chore: update Github workflows and/or pre-commit configuration"
  fi
}

main() {
  # Skip repos that I cannot push to.
  if git transport-is-https; then
    return
  fi
  # Skip forked repos, I should not be updating pre-commit hooks there.
  if git remote show | grep -q upstream; then
    return
  fi
  if git config remote.origin.url >& /dev/null; then
    GIT_MERGE_AUTOEDIT=no git pull
  fi

  # Don't accidentally commit other changes.
  git check-local-copy-is-clean

  if [[ -x ./setup ]]; then
    ./setup
  fi
  if [[ -f ".venv/bin/activate" ]]; then
    . ".venv/bin/activate"
  fi
  update_pre-commit_and_github_workflows
  retry update-dependencies
  if git config remote.origin.url >& /dev/null; then
    git push
  fi
  git gc
}

main "$@"
