#!/bin/bash

set -e -f -u -o pipefail

main() {
  if [[ .venv/bin/activate -nt requirements.txt ]]; then
    echo "venv looks newer than requirements.txt, skipping setup"
    return 0
  fi
  rm -rf .venv
  python3 -m venv .venv
  source .venv/bin/activate
  pip install -r requirements.txt
}

main "$@"
