#!/bin/bash

set -e -f -u -o pipefail

main() {
  local input_file exit_status=0 tmp_dir
  tmp_dir="$(mktemp -d -t "mermaid-pre-commit.XXXXXXXXXXXX")"
  # I want the variable expansion to happen now, because the variable will have
  # gone out of scope at exit time.
  # shellcheck disable=SC2064
  trap "rm -r -f \"${tmp_dir}\"" EXIT
  for input_file in "$@"; do
    if grep -q -F '```mermaid' "${input_file}"; then
      if ! mmdc --quiet --artefacts "${tmp_dir}" --input "${input_file}"; then
        exit_status=1
      fi
    fi
  done
  return "${exit_status}"
}

main "$@"
